npm run format

if ! git diff --exit-code --quiet; then
  echo ""
  echo "⚠️  Prettier reformatted some files. Please commit the changes and push again:"
  echo ""
  git diff --name-only
  echo ""
  exit 1
fi

echo "🔨 Running build..."
if ! npm run build; then
  echo ""
  echo "❌ Build failed. Fix the errors above before pushing."
  echo ""
  exit 1
fi

echo "🔍 Running ESLint..."
if ! npx eslint .; then
  echo ""
  echo "❌ ESLint found errors. Fix them before pushing."
  echo ""
  exit 1
fi

echo "🔷 Running TypeScript type-check..."
if ! npx tsc --noEmit; then
  echo ""
  echo "❌ TypeScript type errors found. Fix them before pushing."
  echo ""
  exit 1
fi

echo ""
echo "✅ All checks passed!"
